@startuml
title BrewLite - Activity đăng ký / đăng nhập (thiết kế)
skinparam defaultFontName Arial
skinparam shadowing false

|Khách hàng / Frontend|
start
:Chọn đăng ký hoặc đăng nhập;
if (Đăng ký?) then (Có)
  :Nhập email, mật khẩu, họ tên;
  :Gửi POST /api/v1/auth/register;
  |Auth API|
  :Kiểm tra DTO\n(email hợp lệ, mật khẩu >= 6 ký tự);
  if (Dữ liệu hợp lệ?) then (Không)
    :Trả HTTP 400;
    |Khách hàng / Frontend|
    :Hiển thị lỗi nhập liệu;
    stop
  else (Có)
    |Database|
    :Tìm user theo email;
    if (Email đã tồn tại?) then (Có)
      |Auth API|
      :Trả HTTP 409;
      |Khách hàng / Frontend|
      :Báo email đã được dùng;
      stop
    else (Không)
      |Auth API|
      :Băm mật khẩu bằng bcrypt;
      |Database|
      :Tạo user\n(loyaltyPoints = 0);
      |Auth API|
      :Ký JWT\n(sub = user.id, email, hạn 7 ngày);
      :Trả HTTP 201\n(accessToken, user);
    endif
  endif
else (Đăng nhập)
  :Nhập email, mật khẩu;
  :Gửi POST /api/v1/auth/login;
  |Auth API|
  :Kiểm tra DTO;
  if (Dữ liệu hợp lệ?) then (Không)
    :Trả HTTP 400;
    |Khách hàng / Frontend|
    :Hiển thị lỗi nhập liệu;
    stop
  else (Có)
    |Database|
    :Tìm user theo email;
    |Auth API|
    :So khớp mật khẩu bằng bcrypt;
    if (User tồn tại và mật khẩu đúng?) then (Không)
      :Trả HTTP 401\n(thông báo chung);
      |Khách hàng / Frontend|
      :Báo sai email hoặc mật khẩu;
      stop
    else (Có)
      :Ký JWT\n(sub = user.id, email, hạn 7 ngày);
      :Trả HTTP 200\n(accessToken, user);
    endif
  endif
endif
|Khách hàng / Frontend|
:Lưu token và cập nhật trạng thái đăng nhập;
stop
@enduml

@startuml
title BrewLite - Đổi mật khẩu và thu hồi JWT cũ
autonumber
actor "Khách hàng" as Customer
participant "Next.js" as FE
participant "JwtAuthGuard" as Guard
participant "AuthController" as Controller
participant "AuthService" as Service
database "PostgreSQL / Prisma" as DB

Customer -> FE: Nhập mật khẩu hiện tại và mật khẩu mới
FE -> Guard: POST /api/v1/auth/change-password\nBearer token cũ
Guard -> DB: So sánh JWT.ver với users.token_version
alt Token sai hoặc bị thu hồi
  Guard --> FE: HTTP 401
else Token hợp lệ
  Guard -> Controller: req.user.sub
  Controller -> Service: changePassword(userId, dto)
  Service -> DB: Đọc password_hash và token_version
  DB --> Service: User
  Service -> Service: bcrypt.compare(currentPassword, password_hash)
  alt Mật khẩu hiện tại sai
    Service --> FE: HTTP 401
  else Hợp lệ
    Service -> Service: bcrypt.hash(newPassword)
    Service -> DB: Cập nhật hash và tăng token_version\n(nếu phiên bản chưa đổi)
    DB --> Service: Đã cập nhật 1 bản ghi
    Service -> Service: Ký JWT mới với ver mới
    Service --> FE: HTTP 200 (accessToken mới, user)
    FE -> FE: Thay token trong localStorage
    FE --> Customer: Thông báo đổi mật khẩu thành công
  end
end
@enduml

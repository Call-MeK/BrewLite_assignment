PORT=4000
DATABASE_URL="postgresql://brewlite_admin:brewlite_secret_pass@localhost:5432/brewlite_db?schema=public"
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRATION=7d
NODE_ENV=development
PAYMENT_DEMO_MODE=true
# Comma-separated users.id allowed to manage payments; empty denies all access.
PAYMENT_ADMIN_USER_IDS=
# Sandbox only. Leave disabled until merchant credentials and public HTTPS callback are configured.
ZALOPAY_SANDBOX_ENABLED=false
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=
# Frontend base URL; backend adds /orders/:id/payment as the return page.
ZALOPAY_REDIRECT_URL=http://localhost:3000

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  E_WALLET
  BANK_CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentSource {
  MOCK
  ZALOPAY_SANDBOX
}

enum ProductSize {
  S
  M
  L
}

enum LoyaltyTransactionType {
  EARNED
  SPENT
  REFUNDED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum IngredientUnit {
  G
  ML
  PIECE
}

// ==========================================
// MODELS
// ==========================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  tokenVersion  Int      @default(0) @map("token_version")
  role          UserRole?
  fullName      String?  @map("full_name")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  cart                Cart?

  @@map("users")
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String?  @map("category_id")
  name        String
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 0) // Tiền VNĐ nguyên chẵn
  imageUrl    String?  @map("image_url")
  stock       Int      @default(0) // Số lượng tồn kho (Task 10 Concurrency)
  version     Int      @default(0) // Phục vụ Optimistic Locking (Task 10)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category   Category?          @relation(fields: [categoryId], references: [id])
  sizePrices ProductSizePrice[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("products")
}

model ProductSizePrice {
  id              String      @id @default(cuid())
  productId       String      @map("product_id")
  size            ProductSize
  priceAdjustment Decimal     @default(0) @map("price_adjustment") @db.Decimal(12, 0) // Phụ thu theo size

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeItems RecipeIngredient[]

  @@unique([productId, size])
  @@map("product_size_prices")
}

model Ingredient {
  id          String @id @default(cuid())
  name        String @db.VarChar(100)
  nameKey     String @unique @map("name_key")
  unit        IngredientUnit
  recipeItems RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  productId    String @map("product_id")
  size         ProductSize
  ingredientId String @map("ingredient_id")
  quantity     Decimal @db.Decimal(12, 3)
  productSize  ProductSizePrice @relation(fields: [productId, size], references: [productId, size], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, size, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model Topping {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Decimal  @db.Decimal(12, 0)
  stock       Int      @default(100)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique // Mã giảm giá ví dụ WELCOME10, GIAM15K
  description     String?
  discountPercent Int?      @map("discount_percent") // % giảm (nếu có)
  discountAmount  Decimal?  @map("discount_amount") @db.Decimal(12, 0) // Số tiền giảm cố định (nếu có)
  maxDiscount     Decimal?  @map("max_discount") @db.Decimal(12, 0) // Mức giảm tối đa
  minOrderAmount  Decimal   @default(0) @map("min_order_amount") @db.Decimal(12, 0) // Đơn tối thiểu
  startDate       DateTime  @default(now()) @map("start_date")
  endDate         DateTime? @map("end_date")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@map("promotions")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    Int         @unique @default(autoincrement()) @map("order_number") // Sinh mã số hiển thị: #1042
  userId         String      @map("user_id")
  promotionId    String?     @map("promotion_id")
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 0) // Tạm tính trước giảm
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 0)
  finalAmount    Decimal     @map("final_amount") @db.Decimal(12, 0) // Tiền thực trả
  pointsEarned   Int         @default(0) @map("points_earned") // Điểm loyalty tích được
  paidAt         DateTime?   @map("paid_at")
  version        Int         @default(0) // Optimistic locking cho chuyển trạng thái đơn
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id])
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  items               OrderItem[]
  payments            Payment[] // 1-N: cho phép retry thanh toán khi thất bại
  statusHistory       OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  productId String      @map("product_id")
  size      ProductSize @default(M)
  quantity  Int         @default(1)
  unitPrice Decimal     @map("unit_price") @db.Decimal(12, 0) // Đã cộng phụ thu size
  lineTotal Decimal     @map("line_total") @db.Decimal(12, 0) // (unitPrice + toppings) * quantity

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id])
  toppings OrderItemTopping[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemTopping {
  id          String  @id @default(cuid())
  orderItemId String  @map("order_item_id")
  toppingId   String  @map("topping_id")
  price       Decimal @db.Decimal(12, 0) // Giá topping tại thời điểm đặt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping   Topping   @relation(fields: [toppingId], references: [id])

  @@map("order_item_toppings")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @map("order_id") // Bỏ @unique để 1 Order hỗ trợ nhiều lượt thử thanh toán (Retry)
  idempotencyKey String        @unique @map("idempotency_key") // Khóa chống trùng lặp (Task 10)
  requestHash    String?       @map("request_hash") // Hash payload request kiểm tra tính toàn vẹn
  amount         Decimal       @db.Decimal(12, 0)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  failureReason  String?       @map("failure_reason")
  transactionRef String?       @map("transaction_ref")
  source         PaymentSource @default(MOCK)
  providerOrderId String?       @unique @map("provider_order_id")
  providerTransactionId String? @unique @map("provider_transaction_id")
  paymentUrl     String?       @map("payment_url")
  providerAmount Decimal?      @map("provider_amount") @db.Decimal(12, 0)
  reviewReason   String?       @map("review_reason")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([source, createdAt])
  @@map("payments")
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String                 @map("user_id")
  orderId   String?                @map("order_id")
  points    Int
  type      LoyaltyTransactionType
  reason    String
  createdAt DateTime               @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("loyalty_transactions")
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String      @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  changedBy  String?     @map("changed_by") // user, barista, system
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Cart {
  id String @id @default(cuid())

  userId String?    @unique @map("user_id")
  user   User?      @relation(fields: [userId], references: [id])
  items  CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id String @id @default(cuid())

  cartId String @map("cart_id")
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId  String      @map("product_id")
  product    Product     @relation(fields: [productId], references: [id])
  quantity   Int         @default(1)
  size       ProductSize @default(M)
  toppingIds String[]    @map("topping_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cart_items")
}
